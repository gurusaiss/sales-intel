PORT=4000

# Optional: if set, AI summaries/outreach drafts use real Groq (Llama 3.3 70B)
# generations. Free, no credit card. Get a key at console.groq.com/keys.
# If unset, the backend falls back to a deterministic template.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: if set AND a company domain is provided in a search, real Hunter.io
# data is used instead of the mock provider. Get a free key at hunter.io/api-keys
# (25 searches/month free, no credit card). NOTE: Hunter blocks Gmail/Yahoo/etc.
# signups — needs a professional email domain, or "Continue with Google" OAuth.
HUNTER_API_KEY=

# Alternative to Hunter if you don't have a professional email — Snov.io accepts
# Gmail signup. Free tier: 50 credits/month, no card. Get keys at app.snov.io
# under Settings > API. Used only if HUNTER_API_KEY is unset and a domain is given.
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# Optional: enables real Gmail send-as-you (queue view "Send via Gmail" button)
# AND Google Calendar meeting scheduling (queue view "Schedule on Calendar").
# Free, no card. Set up at console.cloud.google.com: enable BOTH the Gmail API
# and the Google Calendar API, create an OAuth consent screen (External, add
# yourself as a test user), scopes gmail.send + calendar.events, then create
# an OAuth Client ID (Web application) with GOOGLE_REDIRECT_URI below as an
# authorized redirect URI. If you already connected Gmail before this scope
# was added, click "Disconnect" then reconnect once to grant Calendar access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Strongly recommended once deployed publicly (e.g. on Render): a shared
# secret required (as an x-api-key header) on every /api/search, /api/persons,
# /api/draft, /api/queue, /api/send-email, and /auth/google/disconnect call.
# Without this, anyone who finds your deployed URL can call those endpoints —
# including sending real email once Gmail is connected. Leave blank for local
# dev (no auth enforced). Generate any random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Must match VITE_APP_API_KEY (frontend) and API_KEY in extension/config.js.
APP_API_KEY=

# STRONGLY RECOMMENDED once deployed: Render's free web service disk is
# EPHEMERAL — backend/data/*.json gets wiped on every redeploy and on
# spin-down/spin-up after idling. Without this, real captured data is at
# risk on every future `git push`. Fix: a free Redis-compatible KV store.
# Free, no card: upstash.com -> create a Redis database -> REST API tab ->
# copy the URL and token below. If left blank, falls back to local JSON
# files (fine for local dev, NOT fine once deployed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# REQUIRED once deployed if you use signup/login: signs session tokens
# (HMAC-SHA256). Without a real value, everyone's session is signed with the
# same hardcoded dev fallback, which is not secure for production. Generate
# any random string, same command as APP_API_KEY above. Changing this later
# logs everyone out (all existing tokens stop verifying) — that's expected.
SESSION_SECRET=

# REQUIRED for password-reset/verification links and the Stripe checkout
# redirect to point at the right place. The public URL of the FRONTEND
# (not this backend) — e.g. https://sales-intel-frontend.onrender.com or
# http://localhost:5173 for local dev.
APP_URL=http://localhost:5173

# Optional: enables password reset emails, signup email verification, and
# the opt-in weekly digest. Free tier: 3,000 emails/month, no card. Get a
# key at resend.com/api-keys. Without this, those emails are silently
# skipped (logged, not sent) — signup/login/the rest of the app keep working.
RESEND_API_KEY=
RESEND_FROM="Sales Intel <onboarding@resend.dev>"

# Optional: enables paid tiers (Pro/Team) via Stripe Checkout + Customer
# Portal + usage limit enforcement. Free to integrate — Stripe only takes a
# % of real transactions, no monthly fee. Without these set, billing is
# unconfigured and every account is effectively unlimited (see billing.ts).
# Setup: dashboard.stripe.com (test mode first) -> Developers -> API keys
# for STRIPE_SECRET_KEY; Products -> create "Pro" and "Team" recurring
# prices for STRIPE_PRICE_PRO/STRIPE_PRICE_TEAM; Developers -> Webhooks ->
# add endpoint {APP backend URL}/api/billing/webhook, events
# checkout.session.completed + customer.subscription.updated +
# customer.subscription.deleted, for STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Optional: comma-separated emails allowed to view /api/admin/summary (the
# operator dashboard — signups, tier breakdown, MRR-adjacent counts). Leave
# blank to disable the admin view entirely.
ADMIN_EMAILS=
